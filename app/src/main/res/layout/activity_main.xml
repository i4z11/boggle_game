<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Texto que muestra la palabra que se va formando -->
    <TextView
        android:id="@+id/tvPalabraActual"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Palabra: "
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Grilla 4x4 para las letras del Boggle -->
    <GridLayout
        android:id="@+id/gridLayoutTablero"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:rowCount="4"
        android:columnCount="4"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@id/tvPalabraActual"
        app:layout_constraintBottom_toTopOf="@id/btnEnviarPalabra"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp">

        <!-- Fila 0 -->
        <Button android:id="@+id/btn_0_0" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:textSize="22sp" android:textStyle="bold" tools:text="A" />
        <Button android:id="@+id/btn_0_1" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:textSize="22sp" android:textStyle="bold" tools:text="B" />
        <Button android:id="@+id/btn_0_2" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:textSize="22sp" android:textStyle="bold" tools:text="C" />
        <Button android:id="@+id/btn_0_3" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:textSize="22sp" android:textStyle="bold" tools:text="D" />

        <!-- Fila 1 -->
        <Button android:id="@+id/btn_1_0" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:textSize="22sp" android:textStyle="bold" tools:text="E" />
        <Button android:id="@+id/btn_1_1" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:textSize="22sp" android:textStyle="bold" tools:text="F" />
        <Button android:id="@+id/btn_1_2" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:textSize="22sp" android:textStyle="bold" tools:text="G" />
        <Button android:id="@+id/btn_1_3" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:textSize="22sp" android:textStyle="bold" tools:text="H" />

        <!-- Fila 2 -->
        <Button android:id="@+id/btn_2_0" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:textSize="22sp" android:textStyle="bold" tools:text="I" />
        <Button android:id="@+id/btn_2_1" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:textSize="22sp" android:textStyle="bold" tools:text="J" />
        <Button android:id="@+id/btn_2_2" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:textSize="22sp" android:textStyle="bold" tools:text="K" />
        <Button android:id="@+id/btn_2_3" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:textSize="22sp" android:textStyle="bold" tools:text="L" />

        <!-- Fila 3 -->
        <Button android:id="@+id/btn_3_0" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:textSize="22sp" android:textStyle="bold" tools:text="M" />
        <Button android:id="@+id/btn_3_1" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:textSize="22sp" android:textStyle="bold" tools:text="N" />
        <Button android:id="@+id/btn_3_2" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:textSize="22sp" android:textStyle="bold" tools:text="O" />
        <Button android:id="@+id/btn_3_3" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:textSize="22sp" android:textStyle="bold" tools:text="P" />

    </GridLayout>

    <!-- Botón para enviar la palabra formada -->
    <Button
        android:id="@+id/btnEnviarPalabra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enviar Palabra"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
